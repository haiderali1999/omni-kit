{
  "manifest_version": 3,
  "name": "OmniKit — Tabs, Focus & Dev Tools",
  "version": "2.0.0",
  "description": "All-in-one toolkit: dev utilities, tab sessions, focus mode, clipboard history, screenshots, page watcher, CSS inspector, storage manager, markdown preview & API inspector.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OmniKit"
  },
  "devtools_page": "devtools/devtools.html",
  "content_scripts": [
    {
      "matches": [
        "*://*/*.md",
        "*://*/*.markdown",
        "file:///*.md",
        "file:///*.markdown"
      ],
      "js": [
        "content/markdown.js"
      ],
      "css": [
        "content/markdown.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content/github.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "omnikit@724.one",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "locationInfo"
        ]
      }
    }
  }
}
